[Unit]
Description=Hostess 7 FAST·HARD boot — Internet 2.0 · C++ only · never sudo/pkill
DefaultDependencies=no
After=local-fs.target spear-boot-harden.service
Before=getty.target multi-user.target
Wants=spear-boot-harden.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SPEAR_SWALLOWS_ROOT=/tmp/spear-swallows-www
Environment=SPEAR_ALWAYS_WAR=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/mkdir -p /tmp/spear-swallows-www/hostess7
ExecStart=/usr/local/bin/spear-hostess7-boot boot
TimeoutStartSec=60
Nice=-5
# NEVER sudo. NEVER pkill. C++ binaries only.

[Install]
WantedBy=multi-user.target
